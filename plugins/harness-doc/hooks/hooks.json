{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-docs.mjs\"",
            "timeout": 60,
            "statusMessage": "文書の機械チェックを実行中..."
          }
        ]
      }
    ]
  }
}
