{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-docs.mjs\"",
            "timeout": 60,
            "statusMessage": "文書の機械チェックを実行中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/commit-check.mjs\"",
            "timeout": 60,
            "statusMessage": "文書の改訂の記録を確認中（コミット時）..."
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/reviewer-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
