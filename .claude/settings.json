{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/repo-guard.js\"",
            "timeout": 150,
            "statusMessage": "リポジトリ規約を確認中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/plugins/harness-doc/hooks/scripts/check-docs.mjs\"",
            "timeout": 60,
            "statusMessage": "文書の機械チェックを実行中（ドッグフーディング）..."
          }
        ]
      }
    ]
  }
}
